# Aafiatak environment template
# Copy this file to ".env" and fill in real values.
# The ".env" file itself is gitignored and must never be committed.

# Supabase project credentials (from Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Backend API base URL used by the shared Dio instance
API_BASE_URL=https://api.example.com